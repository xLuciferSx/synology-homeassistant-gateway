# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# Everything secret lives in this file; the code and images contain none.

# --- Hub -------------------------------------------------------------------
HUB_NAME=Home
# The address phones on your Wi-Fi use to reach this hub.
HUB_LAN_URL=http://192.168.1.20:8780
# Optional: an https address that reaches this hub from outside (see SECURITY.md).
HUB_PUBLIC_URL=
# Your timezone, for schedules and daily totals.
TZ=Europe/London

# Local admin token for the app, scripts and debugging. At least 32 characters:
#   openssl rand -hex 32
HOMEAPP_TOKEN=

# Optional: account sign-in through the auth and hubs services (cmd/auth, cmd/hubs).
# Leave empty to use only HOMEAPP_TOKEN.
HOMEAPP_HUBS_URL=
AUTH_JWKS_URL=

# --- Home Assistant (optional provider) -------------------------------------
# Profile → Security → Long-lived access tokens.
HA_URL=http://192.168.1.30:8123
HA_TOKEN=

# --- Zigbee (optional) -----------------------------------------------------
# Where Zigbee2MQTT publishes. Leave empty to use this compose project's broker.
Z2M_MQTT_URL=
Z2M_MQTT_USER=
Z2M_MQTT_PASS=
# true: show Zigbee devices through bridge-zigbee instead of through Home Assistant.
HA_HANDOFF_ZIGBEE=false

# --- Extras ----------------------------------------------------------------
# Home location (2 decimals is plenty) for sunrise/sunset automations.
HOME_LAT=
HOME_LON=
# Thermostat target while away mode is on.
AWAY_TEMP=16

# Push notifications (needs your own Apple developer account and app).
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
